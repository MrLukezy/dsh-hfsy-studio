{
  "name": "dsh-hfsy-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "HFSY 生图/生视频工作台：在 DeepSeek Harness 里用 hfsy 中转的 gpt-image / Seedance 等模型出图出片，带参数面板、画廊、历史与本地落盘。",
  "license": "MIT",
  "icon": "icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image-generation",
    "video-generation",
    "hfsy",
    "gpt-image-2"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}